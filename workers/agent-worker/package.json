{
  "name": "@acos/agent-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run src",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@acos/domain": "workspace:*",
    "@acos/db": "workspace:*",
    "@acos/events": "workspace:*",
    "@acos/llm": "workspace:*",
    "@acos/tools": "workspace:*",
    "@acos/config": "workspace:*"
  }
}
